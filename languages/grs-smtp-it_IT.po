#: includes/admin/class-admin.php:456
msgid "Port"
msgstr "Porta"

#: includes/admin/class-admin.php:460
msgid "Auto TLS"
msgstr "TLS automatico"

#: includes/admin/class-admin.php:461
msgid "Use TLS if the server offers it"
msgstr "Usa TLS se il server lo offre"

#: includes/admin/class-admin.php:461
msgid "Leave enabled. Disable only if the server advertises TLS but its certificate is not valid."
msgstr "Lascia attivo. Disattiva solo se il server dichiara TLS ma il certificato non è valido."

#: includes/admin/class-admin.php:464
msgid "Authentication"
msgstr "Autenticazione"

#: includes/admin/class-admin.php:465
msgid "The server requires a username and password"
msgstr "Il server richiede utente e password"

#: includes/admin/class-admin.php:468
msgid "Username"
msgstr "Utente"

#: includes/admin/class-admin.php:469
msgid "Usually the full email address."
msgstr "Di solito l'indirizzo email completo."

#: includes/admin/class-admin.php:472
msgid "Password"
msgstr "Password"

#: includes/admin/class-admin.php:475
msgid "Set in wp-config.php."
msgstr "Definita in wp-config.php."

#: includes/admin/class-admin.php:477
msgid "•••••••• (saved, leave empty to keep it)"
msgstr "•••••••• (salvata, lascia vuoto per non cambiarla)"

#: includes/admin/class-admin.php:480
msgid "Remove the saved password"
msgstr "Rimuovi la password salvata"

#: includes/admin/class-admin.php:482
msgid "Stored encrypted in the database. Alternatively, define it in wp-config.php with the GRS_SMTP_PASS constant."
msgstr "Salvata cifrata nel database. In alternativa definiscila in wp-config.php con la costante GRS_SMTP_PASS."

#: includes/admin/class-admin.php:482
msgid "OpenSSL is not available on this server: the password is only stored obfuscated. Better to define it in wp-config.php with the GRS_SMTP_PASS constant."
msgstr "OpenSSL non è disponibile su questo server: la password viene salvata solo offuscata. Meglio definirla in wp-config.php con la costante GRS_SMTP_PASS."

#: includes/admin/class-admin.php:490 includes/class-tester.php:91
msgid "Sender"
msgstr "Mittente"

#: includes/admin/class-admin.php:492
msgid "From email"
msgstr "Email mittente"

#: includes/admin/class-admin.php:493
msgid "Use an address on the client's domain, ideally the same as the SMTP username. If empty, the SMTP username is used."
msgstr "Usa un indirizzo del dominio del cliente, meglio se uguale all'utente SMTP. Se vuoto viene usato l'utente SMTP."

#: includes/admin/class-admin.php:495
msgid "Force this address for all emails"
msgstr "Forza questo indirizzo per tutte le email"

#: includes/admin/class-admin.php:495
msgid "Recommended: prevents third-party plugins from using senders the SMTP server would reject. If disabled, only the default wordpress@ address is replaced."
msgstr "Consigliato: evita che plugin di terze parti usino mittenti che il server SMTP rifiuterebbe. Se disattivato viene sostituito solo l'indirizzo predefinito wordpress@."

#: includes/admin/class-admin.php:498
msgid "From name"
msgstr "Nome mittente"

#. translators: %s: nome del sito.
#: includes/admin/class-admin.php:500
#, php-format
msgid "E.g. the company name. If empty, the site name (%s) is used, never \"WordPress\"."
msgstr "Es. il nome dell'azienda. Se vuoto viene usato il nome del sito (%s), mai \"WordPress\"."

#: includes/admin/class-admin.php:502
msgid "Force this name for all emails"
msgstr "Forza questo nome per tutte le email"

#: includes/admin/class-admin.php:502
msgid "If disabled, plugins that set their own name (e.g. WooCommerce) keep it; only \"WordPress\" is replaced."
msgstr "Se disattivato i plugin che impostano un loro nome (es. WooCommerce) lo mantengono; viene sostituito solo \"WordPress\"."

#: includes/admin/class-admin.php:505
msgid "Return-Path"
msgstr "Return-Path"

#: includes/admin/class-admin.php:506
msgid "Align the Return-Path with the sender"
msgstr "Allinea il Return-Path al mittente"

#: includes/admin/class-admin.php:506
msgid "Bounce notifications go back to the sender address."
msgstr "Le notifiche di mancata consegna tornano all'indirizzo mittente."

#: includes/admin/class-admin.php:514
msgid "Email log"
msgstr "Registro invii"

#: includes/admin/class-admin.php:515
msgid "Log sent emails"
msgstr "Registra le email inviate"

#: includes/admin/class-admin.php:517
msgid "Also save the content"
msgstr "Salva anche il contenuto"

#: includes/admin/class-admin.php:517
msgid "Required to view the text and resend. Emails may contain personal data and password reset links: keep retention short."
msgstr "Necessario per vedere il testo e reinviare. Le email possono contenere dati personali e link di reset password: tieni la conservazione breve."

#: includes/admin/class-admin.php:520
msgid "Retention"
msgstr "Conservazione"

#. translators: %d: numero di giorni.
#: includes/admin/class-admin.php:524
msgid "Never delete"
msgstr "Non eliminare mai"

#. translators: %d: numero di giorni.
#: includes/admin/class-admin.php:524
#, php-format
msgid "%d day"
msgid_plural "%d days"
msgstr[0] "%d giorno"
msgstr[1] "%d giorni"

#: includes/admin/class-admin.php:532
msgid "Failure alerts"
msgstr "Avvisi di errore"

#: includes/admin/class-admin.php:534
msgid "Email alert"
msgstr "Avviso via email"

#: includes/admin/class-admin.php:535
msgid "Alert me when a delivery fails"
msgstr "Avvisami quando un invio fallisce"

#: includes/admin/class-admin.php:535
msgid "At most one alert per hour, sent without SMTP. An admin notice is shown in the dashboard anyway."
msgstr "Massimo un avviso all'ora, inviato senza SMTP. In bacheca compare comunque un avviso agli amministratori."

#: includes/admin/class-admin.php:537
msgid "Address that receives the alerts (preferably on another domain, e.g. your support address)."
msgstr "Indirizzo che riceve gli avvisi (meglio di un altro dominio, es. il tuo di assistenza)."

