#. Plugin Name of the plugin
#: grs-smtp.php
msgid "GRS SMTP"
msgstr "GRS SMTP"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: grs-smtp.php
msgid "https://grsdigital.it"
msgstr "https://grsdigital.it"

#. Description of the plugin
#: grs-smtp.php
msgid "Sends WordPress emails through the domain's SMTP server, with test email, delivery log, failure alerts and DNS check."
msgstr "Invia le email di WordPress tramite il server SMTP del dominio, con email di test, log degli invii, avvisi di errore e controllo DNS."

#. Author of the plugin
#: grs-smtp.php
msgid "GRS Digital"
msgstr "GRS Digital"

#: grs-smtp.php:32
msgid "GRS SMTP requires PHP 7.4 or higher. The plugin is not active."
msgstr "GRS SMTP richiede PHP 7.4 o superiore. Il plugin non è attivo."

#: includes/admin/class-admin.php:104
msgid "Sends emails through the domain's SMTP server, with test, log and failure alerts."
msgstr "Invio delle email tramite il server SMTP del dominio, con test, log e avvisi di errore."

