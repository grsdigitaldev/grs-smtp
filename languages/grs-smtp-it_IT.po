msgid "Warning: SMTP is not configured, the email was sent with the server's default method."
msgstr "Attenzione: SMTP non è configurato, l'email è partita con il metodo predefinito del server."

#: includes/class-tester.php:69
msgid "Delivery failed."
msgstr "Invio non riuscito."

